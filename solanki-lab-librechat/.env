# LibreChat environment (loaded by the api + meilisearch containers via env_file).
# Contains NO secrets — JWT_SECRET, JWT_REFRESH_SECRET, CREDS_KEY, CREDS_IV and
# MEILI_MASTER_KEY are generated per-install by hooks/pre-start and appended to
# this file at install time (never commit them to the store).
HOST=0.0.0.0
PORT=3080
MONGO_URI=mongodb://solanki-lab-librechat_mongodb_1:27017/LibreChat
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080
NO_INDEX=true
TRUST_PROXY=1
CONSOLE_JSON=false
DEBUG_LOGGING=true
DEBUG_CONSOLE=false
PROXY=

ANTHROPIC_API_KEY=user_provided
GOOGLE_KEY=user_provided
OPENAI_API_KEY=user_provided
DEBUG_OPENAI=false
ASSISTANTS_API_KEY=user_provided
DEBUG_PLUGINS=true

SEARCH=true
MEILI_NO_ANALYTICS=true
MEILI_HOST=http://solanki-lab-librechat_meilisearch_1:7700

TAVILY_API_KEY=
SERPAPI_API_KEY=
TRAVERSAAL_API_KEY=
WOLFRAM_APP_ID=

# Auth & security
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=true
SESSION_EXPIRY=1000 * 60 * 60 * 24 * 7
REFRESH_TOKEN_EXPIRY=(1000 * 60 * 60 * 24) * 30

# Scheduled Chats (cron): single-process assertion — we run exactly one api replica
# (no Redis). Without this the scheduler refuses to arm and schedules return 503.
SCHEDULES_SINGLE_PROCESS=true
