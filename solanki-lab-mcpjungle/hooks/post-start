#!/usr/bin/env bash
# Post-start hook for MCPJungle in development mode.
#
# In development mode the server enforces no authentication: no client tokens, no
# allow lists. That is a deliberate trade for the dashboard UI, which MCPJungle
# only serves in this mode - in enterprise mode / returns 404, so the app has no
# landing page and fails the umbrel App Store gate that requires a useful web UI
# or status page.
#
# The compensating control is in the compose file, not here: umbrel's app_proxy
# auth is left ON so the dashboard and /api/v0 require an umbrel login, and only
# /mcp is whitelisted because MCP clients cannot send umbrel cookies. See
# PROXY_AUTH_WHITELIST in docker-compose.yml.
#
# What is left for this hook is the one thing that is genuinely useful to
# automate: making sure the Browser Use upstream is registered, so the gateway
# has something to serve. Registration is best-effort - if Browser Use is not
# installed, the log says so and the app is still usable for manual setup.
set -euo pipefail

APP_DIR="${APP_DATA_DIR:-$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/..")}"
PORT="${APP_PROXY_PORT:-8080}"
BU_NAME="browser-use"
BU_URL="${MCPJUNGLE_BROWSER_USE_URL:-http://solanki-lab-browser-use_browser-use_1:8766/mcp}"

log() { echo "mcpjungle: $*" >&2; }

BASE=""
for host in 127.0.0.1 "${DEVICE_HOSTNAME:-}" "${DEVICE_DOMAIN_NAME:-}"; do
  [ -n "$host" ] || continue
  if curl -fsS -o /dev/null --max-time 5 "http://${host}:${PORT}/health" 2>/dev/null; then
    BASE="http://${host}:${PORT}"
    break
  fi
done

if [ -z "$BASE" ]; then
  for _ in $(seq 1 15); do
    for host in 127.0.0.1 "${DEVICE_HOSTNAME:-}" "${DEVICE_DOMAIN_NAME:-}"; do
      [ -n "$host" ] || continue
      if curl -fsS -o /dev/null --max-time 5 "http://${host}:${PORT}/health" 2>/dev/null; then
        BASE="http://${host}:${PORT}"
        break 2
      fi
    done
    sleep 2
  done
fi

if [ -z "$BASE" ]; then
  log "no healthy listener on port ${PORT}; skipping registration"
  exit 0
fi

# POST /api/v0/servers {name, transport, url} -> 201 created, 202 accepted,
# 409 already registered. All three are success.
payload="{\"name\":\"${BU_NAME}\",\"transport\":\"streamable_http\",\"description\":\"Browser automation\",\"url\":\"${BU_URL}\"}"
raw=$(curl -sS -X POST "${BASE}/api/v0/servers" \
  -H 'content-type: application/json' \
  -d "$payload" -w $'\n%{http_code}' 2>/dev/null || true)
status=$(printf '%s' "$raw" | tail -n1)
body=$(printf '%s' "$raw" | sed '$d')

case "$status" in
  201|202)
    log "registered upstream '${BU_NAME}' (HTTP ${status})"
    ;;
  409)
    : # already registered, nothing to do
    ;;
  *)
    log "could not register '${BU_NAME}' (HTTP ${status:-none}): $(printf '%s' "$body" | head -c 200)"
    log "add it from the dashboard at ${BASE}/ or with: mcpjungle register --name ${BU_NAME} --url ${BU_URL}"
    ;;
esac
