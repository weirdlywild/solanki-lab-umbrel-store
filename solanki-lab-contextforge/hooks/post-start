#!/usr/bin/env bash
# Surface the derived platform-admin password where the operator can read it.
#
# The password is derived from the device seed rather than stored, so that no
# secret is ever committed to the public store repo. That has a cost: nobody can
# guess it. This copies it into the app data directory at mode 600 so the owner
# can read it through the umbrel UI and sign in to the admin panel.
set -euo pipefail
umask 077

APP_DIR="${APP_DATA_DIR:-$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/..")}"
OUT="${APP_DIR}/data/platform-admin.txt"

if [ -z "${APP_CONTEXTFORGE_ADMIN_PASSWORD:-}" ]; then
  echo "contextforge: admin password not in the environment; run exports.sh first" >&2
  exit 0
fi

mkdir -p "${APP_DIR}/data"
{
  printf 'email    : %s\n' "${PLATFORM_ADMIN_EMAIL:-admin@solanki.home}"
  printf 'password : %s\n' "${APP_CONTEXTFORGE_ADMIN_PASSWORD}"
  printf 'admin ui : http://%s:4444/admin\n' "${DEVICE_HOSTNAME:-<umbrel-host>}"
  printf '\nThis file is derived from your umbrel device seed. Delete it once you\n'
  printf 'have signed in and changed the password.\n'
} > "$OUT"
chmod 600 "$OUT"
echo "contextforge: wrote admin credentials to ${OUT}" >&2
